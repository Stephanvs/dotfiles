{
  "theme": {
    "name": "orng",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "grouping": "auto",
    "tps": true,
    "markdown": "rendered",
    "verbosity": "low",
    "permissions": "autoaccept"
  },
  "animations": true,
  "prompt": {
    "paste": "full",
    "image_preview": false
  },
  "highlights": true,
  "tabs": {
    "layout": "horizontal",
    "indicators": "numbers",
    "scope": "global",
    "mode": "auto"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.7
  },
  "terminal": {
    "title": true,
    "copy": "manual"
  }
}
